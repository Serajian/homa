{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Setting up a call in homa",
    "output": "docs/assets/call-setup.html",
    "viewBox": [
      1000,
      560
    ],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    {
      "id": "caller",
      "type": "external",
      "label": "Caller",
      "sublabel": "the person dialing"
    },
    {
      "id": "dial",
      "type": "frontend",
      "label": "homa",
      "sublabel": "ui.dial, ui.startChat"
    },
    {
      "id": "tunnel",
      "type": "security",
      "label": "tailcat",
      "sublabel": "WireGuard, via a relay"
    },
    {
      "id": "answer",
      "type": "frontend",
      "label": "homa",
      "sublabel": "ui.greet, ui.offer"
    },
    {
      "id": "callee",
      "type": "external",
      "label": "Callee",
      "sublabel": "the person called"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 238,
      "label": "Reach the machine"
    },
    {
      "from": 252,
      "to": 320,
      "label": "Greet"
    },
    {
      "from": 334,
      "to": 430,
      "label": "Ask the person"
    },
    {
      "from": 444,
      "to": 512,
      "label": "Talk"
    }
  ],
  "messages": [
    {
      "id": "pick",
      "from": "caller",
      "to": "dial",
      "y": 172,
      "label": "pick a contact",
      "variant": "default"
    },
    {
      "id": "dialout",
      "from": "dial",
      "to": "tunnel",
      "y": 200,
      "label": "peer.Dial, 60s limit",
      "variant": "emphasis"
    },
    {
      "id": "accept",
      "from": "tunnel",
      "to": "answer",
      "y": 228,
      "label": "listener.Accept",
      "variant": "emphasis"
    },
    {
      "id": "hello-out",
