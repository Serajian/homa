    {
      "id": "waiting",
      "from": "dial",
      "to": "caller",
      "y": 378,
      "label": "waiting for them to answer... 56s",
      "variant": "return"
    },
    {
      "id": "yes",
      "from": "callee",
      "to": "answer",
      "y": 400,
      "label": "y",
      "variant": "emphasis"
    },
    {
      "id": "accepted",
      "from": "answer",
      "to": "dial",
      "y": 418,
      "label": "ACCEPT 0x09",
      "variant": "security"
    },
    {
      "id": "talking",
      "from": "dial",
      "to": "caller",
      "y": 458,
      "label": "talking to server-b",
      "variant": "return"
    },
    {
      "id": "connected",
      "from": "answer",
      "to": "callee",
      "y": 458,
      "label": "connected to ~sara",
      "variant": "return"
    },
    {
      "id": "text",
      "from": "dial",
      "to": "answer",
      "y": 476,
      "label": "TEXT, both ways",
      "variant": "default"
