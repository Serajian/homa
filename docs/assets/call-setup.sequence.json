      "to": "answer",
      "y": 268,
      "label": "HELLO {nick, version 2}",
      "variant": "default"
    },
    {
      "id": "hello-back",
      "from": "answer",
      "to": "dial",
      "y": 302,
      "label": "HELLO {nick, version 2}",
      "variant": "return"
    },
    {
      "id": "ring",
      "from": "answer",
      "to": "callee",
      "y": 350,
      "label": "~sara is calling (expires in 1m0s)",
